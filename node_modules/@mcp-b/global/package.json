{
  "name": "@mcp-b/global",
  "version": "2.2.0",
  "description": "W3C Web Model Context API polyfill - Let AI agents like Claude, ChatGPT, and Gemini interact with your website via navigator.modelContext",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-model-context",
    "navigator-modelcontext",
    "w3c",
    "browser",
    "polyfill",
    "web-standard",
    "ai-agents",
    "ai-tools",
    "llm",
    "claude",
    "chatgpt",
    "openai",
    "anthropic",
    "cursor",
    "copilot",
    "gemini",
    "webmcp",
    "tool-registration",
    "ai-integration",
    "browser-ai",
    "web-ai",
    "ai-assistant",
    "chromium",
    "iife"
  ],
  "homepage": "https://docs.mcp-b.ai/packages/global",
  "bugs": {
    "url": "https://github.com/WebMCP-org/npm-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMCP-org/npm-packages.git",
    "directory": "packages/global"
  },
  "license": "MIT",
  "author": "Alex Nahas",
  "sideEffects": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./iife": {
      "script": "./dist/index.iife.js",
      "default": "./dist/index.iife.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.iife.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mcp-b/transports": "2.2.0",
    "@mcp-b/webmcp-ts-sdk": "2.2.0",
    "@mcp-b/webmcp-polyfill": "2.2.0",
    "@mcp-b/webmcp-types": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "fast-check": "^4.0.0",
    "playwright": "^1.58.0",
    "tsdown": "^0.15.10",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "check": "biome check --write .",
    "clean": "rm -rf dist .turbo",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "publish:dry": "pnpm publish --access public --dry-run",
    "publish:npm": "pnpm publish --access public",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless",
    "test:browser:ui": "vitest --browser",
    "test:conformance:matrix": "pnpm run test:conformance:polyfill && pnpm run test:conformance:native",
    "test:conformance:native": "vitest run --config vitest.conformance.native.config.ts --browser.headless",
    "test:conformance:polyfill": "vitest run --config vitest.conformance.polyfill.config.ts --browser.headless",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && vitest run --typecheck --silent",
    "version:major": "pnpm version major --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:patch": "pnpm version patch --no-git-tag-version"
  }
}