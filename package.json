{
  "name": "webmcp-chat",
  "version": "0.5.1",
  "description": "Open-source React chat assistant for WebMCP apps. Drop in a production-ready Gemini-powered widget with built-in UI and fast setup.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && node ./scripts/postbuild.mjs",
    "dev": "vite",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "react",
    "chat-widget",
    "chat-assistant",
    "gemini",
    "tool-calling",
    "opensource",
    "ai"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mcp-b/transports": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@mcp-b/react-webmcp": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mcp-b/transports": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.43.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vitest": "^2.1.8"
  }
}
